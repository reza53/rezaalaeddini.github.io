<div class="col" style="margin-bottom: 1.5rem;">
  <div class="card h-100 hoverable" style="display: flex; flex-direction: column; height: 100% !important;">
    <a href="{% if project.redirect %}{{ project.redirect }}{% else %}{{ project.url | relative_url }}{% endif %}" style="text-decoration: none; color: inherit; display: flex; flex-direction: column; height: 100%;">
      {% if project.img %}
        {% include figure.liquid loading="eager" path=project.img sizes="250px" alt="project thumbnail" class="card-img-top" %}
      {% endif %}
      <div class="card-body" style="flex-grow: 1; display: flex; flex-direction: column;">
        <h2 class="card-title" style="font-size: 1.5rem;">{{ project.title }}</h2>
        <p class="card-text" style="flex-grow: 1;">{{ project.description }}</p>
        <div class="row ml-1 mr-1 p-0" style="margin-top: auto;">
          {% if project.github %}
            <div class="github-icon">
              <div class="icon" data-toggle="tooltip" title="Code Repository">
                <a href="{{ project.github }}"><i class="fa-brands fa-github gh-icon"></i></a>
              </div>
              {% if project.github_stars %}
                <span class="stars" data-toggle="tooltip" title="GitHub Stars">
                  <i class="fa-solid fa-star"></i>
                  <span id="{{ project.github_stars }}-stars"></span>
                </span>
              {% endif %}
            </div>
          {% endif %}
        </div>
      </div>
    </a>
  </div>
</div>
